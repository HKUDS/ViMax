# =============================================================================
# ViMax Platform — Environment Variables
# Copy to .env and fill in your values.
# =============================================================================

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://vimax:vimax@localhost:5432/vimax

# ── Redis (queue + pub/sub) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── S3 / MinIO Object Storage ───────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vimax-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ── API Server ──────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-secret

# ── AI Provider API Keys ────────────────────────────────────────────────────
# Required for image generation (Doubao Seedream / Google NanoBanana)
ARK_API_KEY=your_ark_api_key_here

# ── 免费生成渠道（docs/specs/FREE-MEDIA-MODELS-RESEARCH.md）──────────────────
# 智谱 BigModel（长期免费）: CogView-3-Flash 生图 + CogVideoX-Flash 生视频
# https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=
# 魔搭 API-Inference（每日 2000 次免费，需阿里云实名）: https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_TOKEN=
# Agnes AI（OpenAI 兼容多模态，https://www.agnes-ai.com）：图像 agnes-image-2.5-flash、
# 视频 agnes-video-2.5 / agnes-video-2.5-flash；文本模型在 Settings → Models 配置
# （provider=agnes，Base URL=https://apihub.agnes-ai.com/v1）
AGNES_API_KEY=

# 免费链路默认模型（未显式选模型时生效；填 contracts preset id）
# DEFAULT_IMAGE_MODEL=cogview-3-flash        # 或 modelscope-qwen-image / doubao-seedream-4-0
# DEFAULT_VIDEO_MODEL=cogvideox-flash
# i2i（带参考图/编辑）默认档：默认生图模型不支持参考图时回退到它
# DEFAULT_I2I_IMAGE_MODEL=modelscope-qwen-image-edit   # Qwen-Image-Edit-2509，需 MODELSCOPE_API_TOKEN

# 前端默认选中的模型（与上面 DEFAULT_* 对应，构建时注入）
# NEXT_PUBLIC_DEFAULT_IMAGE_MODEL=cogview-3-flash
# NEXT_PUBLIC_DEFAULT_VIDEO_MODEL=cogvideox-flash

# ── ViMax Python Worker ─────────────────────────────────────────────────────
# Path to the parent repo containing tools/ (image/video generators)
VIMAX_ROOT=..

# ── Next.js Frontend (used by apps/web) ─────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:3001/trpc

# ── Local-first asset policy ────────────────────────────────────────────────
# Unclaimed generated binaries are kept server-side for this many hours before
# the sweep deletes them (metadata rows stay). 0 disables the sweep.
ASSET_SWEEP_TTL_HOURS=24
